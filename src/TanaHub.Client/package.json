{
  "name": "tanahub-client",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "doctor": "node ../../scripts/check-environment.mjs",
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:bridge": "node scripts/prepare-bridge.mjs",
    "tauri": "tauri",
    "desktop:dev": "npm run prepare:bridge && tauri dev",
    "desktop:build": "npm run prepare:bridge && tauri build",
    "test": "playwright test",
    "test:transport": "node scripts/test-bridge-transport.mjs",
    "test:core": "node scripts/test-prepared-bridge.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.50.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.3"
  }
}
