<UserControl
    x:Class="TanaHub.UI.Views.Controls.RelatedTitlesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:TanaHub.UI.ViewModels"
    xmlns:controls="clr-namespace:TanaHub.UI.Views.Controls"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:DataType="vm:RelatedTitlesViewModel">
  <Border Classes="panel">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="eyebrow-bar" Background="{DynamicResource TanaHubCyanBrush}"/>
        <TextBlock Classes="eyebrow" Text="RELATED TITLES"
                   Foreground="{DynamicResource TanaHubTextPrimaryBrush}"/>
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                   VerticalAlignment="Center" Foreground="{DynamicResource TanaHubTextMutedBrush}"/>
        <Button Grid.Column="1" Classes="ghost" Content="Try again" Padding="12,6"
                IsVisible="{Binding CanRetry}" IsEnabled="{Binding !IsLoading}" Command="{Binding RetryCommand}"
                AutomationProperties.Name="Retry loading related titles"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RelatedTitleGroupViewModel">
            <StackPanel Spacing="8" Margin="0,0,0,12">
              <Button Classes="ghost" HorizontalContentAlignment="Stretch" Padding="10,8"
                      Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding ToggleLabel}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold"
                             TextWrapping="Wrap" Foreground="{DynamicResource TanaHubTextPrimaryBrush}"/>
                  <material:MaterialIcon Grid.Column="1" Kind="{Binding ExpansionIcon}" Width="16" Height="16"
                                         Foreground="{DynamicResource TanaHubTextMutedBrush}"/>
                </Grid>
              </Button>
              <ItemsControl ItemsSource="{Binding Titles}" IsVisible="{Binding IsExpanded}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemWidth="300"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RelatedTitleViewModel">
                    <Button Classes="row" Width="292" Margin="0,0,8,8" Padding="10"
                            HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}"
                            AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding Title}">
                      <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                        <Border Width="48" Height="70" VerticalAlignment="Top" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource TanaHubSurfaceRaisedBrush}">
                          <controls:RemoteImage SourceUri="{Binding PosterUri}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding RelationLabel}" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TanaHubCyanBrush}"/>
                          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TanaHubTextPrimaryBrush}"/>
                          <TextBlock Text="{Binding Metadata}" FontSize="10" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TanaHubTextMutedBrush}"/>
                          <TextBlock Text="{Binding LibraryLabel}" FontSize="10" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding LibraryLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Foreground="{DynamicResource TanaHubTextSecondaryBrush}"/>
                          <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                     Foreground="{DynamicResource TanaHubTextMutedBrush}"/>
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
